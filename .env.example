# Copy to .env for Docker Compose. Generate a unique key for each installation.
APP_KEY=
DB_PASSWORD=change-this-before-running
APP_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:8080
# Local development only: set this to the computer's Wi-Fi IPv4 address when
# previewing from another device on the same network.
DEV_HOST=localhost
DEV_PORT=8080
PLAYBACK_DIAGNOSTIC_RETENTION_DAYS=7
# Example: [{"key":"eu-west","label":"Europe West","endpoint":"https://probe.example.org/v1/check","token":"replace-me"}]
LIVESTREAM_PROBE_REGIONS=[]
# Configure a delivery transport before enabling staff password recovery.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Ministry Platform
# Private, S3-compatible media storage. Run `ministry:storage-preflight` after configuring it.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
